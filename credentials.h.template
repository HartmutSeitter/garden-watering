// TTN credentials — copy this file to credentials.h and fill in your values.
// credentials.h is excluded from git (.gitignore) to protect secret keys.
//
// NODE_ID is set per PlatformIO environment in platformio.ini (-D NODE_ID=1/2/3).
// Values from TTN console: Device → Overview → DevEUI, AppEUI, AppKey

#ifndef _CREDENTIALS_H_
#define _CREDENTIALS_H_

// IDE/clang fallback — PlatformIO overrides this via -D NODE_ID=X in build_flags
#ifndef NODE_ID
  #define NODE_ID 1
#endif

#if NODE_ID == 1
  #define NODE_NAME "garden-node-1"
  #define DEVEUI  "0000000000000000"   // 16 hex chars, MSB first, from TTN device overview
  #define APPEUI  "0000000000000000"   // 16 hex chars, from TTN application
  #define APPKEY  "00000000000000000000000000000000"  // 32 hex chars

#elif NODE_ID == 2
  #define NODE_NAME "garden-node-2"
  #define DEVEUI  "0000000000000000"
  #define APPEUI  "0000000000000000"
  #define APPKEY  "00000000000000000000000000000000"

#elif NODE_ID == 3
  #define NODE_NAME "garden-node-3"
  #define DEVEUI  "0000000000000000"
  #define APPEUI  "0000000000000000"
  #define APPKEY  "00000000000000000000000000000000"

#elif NODE_ID == 4
  #define NODE_NAME "garden-node-4"
  #define DEVEUI  "0000000000000000"
  #define APPEUI  "0000000000000000"
  #define APPKEY  "00000000000000000000000000000000"

#endif // NODE_ID

#endif // _CREDENTIALS_H_
