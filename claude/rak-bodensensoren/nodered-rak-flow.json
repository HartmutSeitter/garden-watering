    {
        "id": "rak_bat_telegram_func",
        "type": "function",
        "z": "6d502ec9.7e555",
        "name": "Telegram Batterie-Alert",
        "func": "var nodeName = msg.nodeName || \"Unbekannt\";\nvar bat = msg.payload.Bat_f;\nvar contextKey = \"lastAlert_\" + nodeName;\nvar now = Date.now();\nvar lastAlert = context.get(contextKey) || 0;\nvar throttleMs = 4 * 60 * 60 * 1000; // 4 Stunden\n\nif (now - lastAlert < throttleMs) {\n    return null;\n}\n\ncontext.set(contextKey, now);\n\nmsg.payload = {\n    chatid: \"5846653852\",\n    type: \"message\",\n    content: \"\\u26a0\\ufe0f RAK Bodensensor *\" + nodeName + \"*\\nBatteriespannung niedrig: *\" + bat.toFixed(2) + \" V*\\n(Schwellwert: 3,8 V)\"\n};\nmsg.options = { parse_mode: \"Markdown\" };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "x": 1120,
        "y": 420,
        "wires": [["rak_telegram_sender"]]
